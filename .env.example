PORT=3001
# Optional DNS override if the network cannot resolve Atlas SRV records.
DNS_SERVERS=
MONGODB_URI=mongodb://127.0.0.1:27017/bizz
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# MONGO_URI is preferred; MONGODB_URI remains supported for existing setups.
MONGO_URI=
CLIENT_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173

# Browser key: restrict to your website origins and Maps JavaScript / Places APIs.
VITE_GOOGLE_MAPS_API_KEY=
# Optional production map ID; development falls back to DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=
